# ============================================================
# TUTORING PLATFORM — Frontend Dockerfile
# Multi-stage build: dev stage + production stage
# ============================================================

# ─── Stage 1: Base ──────────────────────────────────────────
FROM node:20-alpine AS base
WORKDIR /app
# Install only prod-safe OS deps
RUN apk add --no-cache libc6-compat
# Copy package files first (layer cache — only reinstalls if these change)
COPY frontend/package*.json ./
RUN npm ci


# ─── Stage 2: Development ───────────────────────────────────
FROM base AS development
ENV NODE_ENV=development
# Copy full frontend source
COPY frontend/ .
EXPOSE 5173
# Vite dev server — binds to 0.0.0.0 so Docker port mapping works
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]


# ─── Stage 3: Builder (for production) ──────────────────────
FROM base AS builder
ENV NODE_ENV=production
COPY frontend/ .
# Build args passed in from docker-compose or CI
ARG VITE_API_URL
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_SOCKET_URL
ARG VITE_APP_NAME
# Bake env vars into the Vite build
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL
ENV VITE_APP_NAME=$VITE_APP_NAME
RUN npm run build


# ─── Stage 4: Production (Nginx) ────────────────────────────
FROM nginx:alpine AS production
# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*
# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html
# Custom nginx config — handles React Router client-side routing
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]