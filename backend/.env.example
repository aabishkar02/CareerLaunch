# ─── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/career_launch?schema=public"

# ─── Business config ──────────────────────────────────────────
# UUID of the canonical Course row that owns all 8 legacy modules.
# Run: SELECT id FROM courses WHERE slug='...' LIMIT 1; — copy the UUID here.
# REQUIRED — standard plan purchases (starter/professional/complete/single) will
# fail silently if this is unset or points to a non-existent course.
CANONICAL_COURSE_ID=
DB_USER=postgres
DB_HOST=127.0.0.1
DB_NAME=career_launch
DB_PASSWORD=
DB_PORT=5432

# ─── Auth / JWT ───────────────────────────────────────────────
# Generate strong random values, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
# Comma-separated list of allowed frontend origins
FRONTEND_URL="http://localhost:5173"

# ─── Payments (Stripe) ────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Required for webhook signature verification (stripe listen / dashboard endpoint)
STRIPE_WEBHOOK_SECRET=
# Coupon codes: comma-separated CODE:DISCOUNT_CENTS pairs (e.g. LAUNCH50:5000)
COUPON_CODES=
# Set to "true" ONLY in local dev to auto-confirm payments with a Stripe test card.
# Never honored when NODE_ENV=production.
ENABLE_TEST_PAYMENTS=false

# ─── Email (SMTP) ─────────────────────────────────────────────
# Fill in before deploying or password-reset emails will not send.
# Gmail: smtp.gmail.com:587 with an App Password. Resend: smtp.resend.com:587, user=resend, pass=<api_key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Career Launch <noreply@careerlaunch.app>"
